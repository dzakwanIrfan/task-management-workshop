meta {
  name: List After Delete
  type: http
  seq: 22
}

get {
  url: {{baseUrl}}/tasks
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Task hilang dari daftar", function () {
    expect(res.getBody()).to.be.an('array');
    expect(res.getBody().some(t => t.id === bru.getVar('taskId'))).to.equal(false);
  });
}
