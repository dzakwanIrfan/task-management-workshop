meta {
  name: Other User List
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/tasks
  body: none
  auth: bearer
}

auth:bearer {
  token: {{otherToken}}
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Task user pertama tidak bocor", function () {
    const tasks = res.getBody();
    expect(tasks).to.be.an('array');
    expect(tasks.some(t => t.id === bru.getVar('taskId'))).to.equal(false);
    expect(tasks.every(t => t.userId === bru.getVar('otherUserId'))).to.equal(true);
  });
}
