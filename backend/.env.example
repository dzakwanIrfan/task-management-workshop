# Local backend API and frontend origin for CORS.
PORT=3001
FRONTEND_URL=http://localhost:3000

# Local-only PostgreSQL example from the Day 1 Docker setup.
# Replace this URL if your workshop database uses different credentials.
DATABASE_URL="postgresql://workshop:workshop_local_only@localhost:5433/task_management?schema=public"

# Generate a unique value with: openssl rand -hex 32
JWT_SECRET=

# Optional: fill both before running pnpm exec prisma db seed.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
